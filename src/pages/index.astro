---

<Layout
  title="Grand BBQ — Basra's Smokehouse & Burger Bar by Chef Murad | كراند باربكيو"
  description="Grand BBQ (كراند باربكيو) — low-and-slow smoked meats, charcoal-kissed burgers and Italian plates by Chef Murad. Two branches in Basra: Al-Sa'i & Madinat Al-Amal. Call 0772 511 1190."
  image={place.heroImage}
>
  <Header phone={branches[0].tel} />
  <main id="main">
    <Hero
      image={place.heroImage}
      rating={place.rating}
      total={place.total}
      followers={ig.followers}
      openNow={place.openNow}
      tel={branches[0].tel}
    />
    <Marquee />
    <Signatures images={[posts[5].image_url, posts[6].image_url, posts[3].image_url, posts[0].image_url]} />
    <Story image={posts[9].image_url} image2={posts[7].image_url} />
    <Reviews rating={place.rating} total={place.total} followers={ig.followers} />
    <InstagramFeed posts={posts} profile={ig} />
    <Locations branches={branches} address={place.address} openNow={place.openNow} />
    <FAQ />
    <CTA tel={branches[0].tel} phone={branches[0].phone} />
  </main>
  <Footer branches={branches} igUrl={ig.url} />
</Layout>