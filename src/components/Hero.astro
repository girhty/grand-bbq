---
interface Props {
  image: string;
  rating: number;
  total: number;
  followers: number;
  openNow: boolean;
  tel: string;
}
const { image, rating, total, followers, openNow, tel } = Astro.props;
const followersK = `${Math.floor(followers / 1000)}K+`;
---

<section id="top" class="relative isolate min-h-[100svh] overflow-hidden pt-28 pb-16 sm:pt-32" aria-labelledby="hero-title">
  <!-- mesh gradients -->
  <div aria-hidden="true" class="absolute inset-0 -z-10">
    <div class="absolute -left-40 top-10 h-[36rem] w-[36rem] rounded-full bg-ember-600/30 blur-[120px] animate-flicker"></div>
    <div class="absolute right-[-10rem] top-[-6rem] h-[30rem] w-[30rem] rounded-full bg-flame-500/20 blur-[120px]"></div>
    <div class="absolute bottom-[-12rem] left-1/3 h-[28rem] w-[40rem] rounded-full bg-ember-700/25 blur-[140px]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,.035)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.035)_1px,transparent_1px)] bg-[size:64px_64px] [mask-image:radial-gradient(ellipse_at_center,black_30%,transparent_75%)]"></div>
  </div>

  <div class="scroll-fade mx-auto grid max-w-7xl items-center gap-12 px-5 sm:px-8 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <div class="reveal flex flex-wrap items-center gap-2.5">
        {openNow && (
          <span class="inline-flex items-center gap-2 rounded-full border border-emerald-400/30 bg-emerald-400/10 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-emerald-300">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-400 animate-pulseRing"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
            </span>
            Open now
          </span>
        )}
        <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-eyebrow text-ash-200">
          Basra · Est. by Chef Murad
        </span>
      </div>

      <h1 id="hero-title" class="mt-7 font-display uppercase leading-[0.86] tracking-tight">
        <span class="reveal-clip block text-[clamp(3.6rem,11vw,9.5rem)]" style="--d:100ms">Smoke.</span>
        <span class="reveal-clip block text-[clamp(3.6rem,11vw,9.5rem)] text-fire" style="--d:250ms">Fire.</span>
        <span class="reveal-clip block text-[clamp(3.6rem,11vw,9.5rem)]" style="--d:400ms">Grand.</span>
      </h1>

      <p class="reveal mt-7 max-w-xl text-lg leading-relaxed text-ash-300 sm:text-xl" style="--d:500ms">
        The <strong class="font-semibold text-ash-100">best BBQ &amp; burger in town</strong> — low-and-slow smoked meats,
        charcoal-kissed smash burgers and Italian plates, made exclusively by Iraqi hands.
      </p>
      <p class="reveal mt-3 font-arabic text-lg text-flame-300" lang="ar" dir="rtl" style="--d:560ms">
        مو مجرد بركر… تجربة شواء تستحق تنعاد
      </p>

      <div class="reveal mt-9 flex flex-wrap items-center gap-4" style="--d:650ms">
        <a
          href={`tel:${tel}`}
          class="magnetic group relative inline-flex items-center gap-3 overflow-hidden rounded-full bg-gradient-to-r from-flame-400 via-ember-500 to-ember-600 px-8 py-4 text-base font-bold text-coal-950 shadow-[0_0_50px_-8px_rgba(255,90,31,.9)]"
        >
          <span class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/40 to-transparent transition-transform duration-700 group-hover:translate-x-full" aria-hidden="true"></span>
          <span class="relative">Reserve / Order Now</span>
          <svg viewBox="0 0 24 24" class="relative h-5 w-5 transition group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="#menu" class="inline-flex items-center gap-2 rounded-full border border-white/15 px-7 py-4 font-semibold text-ash-100 transition hover:border-flame-400/60 hover:bg-white/5">
          Explore signatures
        </a>
      </div>

      <dl class="reveal mt-12 grid max-w-xl grid-cols-3 gap-3" style="--d:750ms">
        <div class="glass rounded-2xl p-4">
          <dt class="text-[11px] uppercase tracking-[0.2em] text-ash-400">Instagram</dt>
          <dd class="mt-1 font-display text-3xl">{followersK}</dd>
        </div>
        <div class="glass rounded-2xl p-4">
          <dt class="text-[11px] uppercase tracking-[0.2em] text-ash-400">Google</dt>
          <dd class="mt-1 flex items-baseline gap-1 font-display text-3xl">
            <span class="text-flame-400" aria-hidden="true">★</span>{rating}
            <span class="font-sans text-xs text-ash-400">({total})</span>
          </dd>
        </div>
        <div class="glass rounded-2xl p-4">
          <dt class="text-[11px] uppercase tracking-[0.2em] text-ash-400">Branches</dt>
          <dd class="mt-1 font-display text-3xl">02</dd>
        </div>
      </dl>
    </div>

    <div class="relative lg:col-span-5">
      <div class="reveal-scale relative mx-auto aspect-[3/4] w-full max-w-md" style="--d:300ms">
        <div class="absolute -inset-4 rounded-[2.5rem] bg-gradient-to-br from-flame-400/40 via-ember-500/30 to-transparent blur-2xl" aria-hidden="true"></div>
        <div class="relative h-full overflow-hidden rounded-[2rem] border border-white/10 bg-coal-800">
          <img
            src={image}
            alt="Inside Grand BBQ in Basra — the smokehouse dining room"
            class="parallax h-full w-full object-cover"
            loading="eager"
            fetchpriority="high"
            referrerpolicy="no-referrer"
            width="408"
            height="544"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-coal-950/90 via-coal-950/10 to-transparent" aria-hidden="true"></div>
          <div class="absolute inset-x-5 bottom-5 glass rounded-2xl p-4">
            <p class="text-[11px] font-semibold uppercase tracking-eyebrow text-flame-300">Signature</p>
            <p class="mt-1 font-display text-2xl tracking-wide">Slow-Smoked Brisket</p>
            <p class="font-arabic text-sm text-ash-300" lang="ar" dir="rtl">اطيب لحم مدخن 🥩🔥</p>
          </div>
        </div>
        <div class="absolute -left-6 top-10 hidden animate-floaty rounded-2xl glass px-4 py-3 sm:block">
          <p class="font-display text-xl">🔥 12h+</p>
          <p class="text-xs text-ash-300">low &amp; slow</p>
        </div>
      </div>
    </div>
  </div>

  <a href="#menu" class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-[10px] uppercase tracking-eyebrow text-ash-400 md:flex" aria-label="Scroll to signatures">
    Scroll
    <span class="h-10 w-px bg-gradient-to-b from-flame-400 to-transparent"></span>
  </a>
</section>