---
interface Post { caption: string; image_url: string; likes: number }
interface Props {
  posts: Post[];
  profile: { username: string; name: string; followers: number; profilePic: string; url: string };
}
const { posts, profile } = Astro.props;
const shown = posts.slice(0, 9);
const truncate = (s: string, n = 110) => (s.length > n ? s.slice(0, n).trim() + '…' : s);
const fmt = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(1).replace('.0', '')}K` : String(n));
---

<section id="instagram" class="relative overflow-hidden py-24 sm:py-32" aria-labelledby="ig-title">
  <div aria-hidden="true" class="absolute inset-0 -z-10">
    <div class="absolute left-1/2 top-0 h-[30rem] w-[60rem] -translate-x-1/2 rounded-full bg-gradient-to-r from-fuchsia-600/10 via-ember-500/15 to-flame-400/10 blur-[120px]"></div>
  </div>

  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="glass reveal flex flex-col items-start justify-between gap-6 rounded-3xl p-6 sm:flex-row sm:items-center sm:p-8">
      <div class="flex items-center gap-4">
        <span class="rounded-full bg-gradient-to-tr from-flame-400 via-ember-500 to-fuchsia-600 p-[3px]">
          <img src={profile.profilePic} alt={`${profile.name} Instagram profile picture`} width="72" height="72" loading="lazy" referrerpolicy="no-referrer" class="h-16 w-16 rounded-full border-4 border-coal-900 bg-coal-800 object-cover sm:h-[72px] sm:w-[72px]" />
        </span>
        <div>
          <h2 id="ig-title" class="font-display text-3xl tracking-wide">@{profile.username}</h2>
          <p class="font-arabic text-ash-300" lang="ar" dir="rtl">{profile.name}</p>
          <p class="text-xs uppercase tracking-[0.2em] text-ash-400">Best BBQ &amp; Burger in Town · By Chef Murad</p>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <div class="text-right">
          <p class="font-display text-4xl leading-none">{fmt(profile.followers)}</p>
          <p class="text-xs uppercase tracking-[0.2em] text-ash-400">Followers</p>
        </div>
        <a href={profile.url} target="_blank" rel="noopener" class="magnetic inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-ember-500 to-fuchsia-600 px-6 py-3 font-bold text-white shadow-[0_0_40px_-10px_rgba(236,72,153,.8)]">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
          Follow
        </a>
      </div>
    </div>

    <ul class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3">
      {shown.map((p, i) => (
        <li class={`reveal-scale ${i === 0 ? 'md:col-span-2 md:row-span-2' : ''}`} style={`--d:${(i % 3) * 90}ms`}>
          <a
            href={profile.url}
            target="_blank"
            rel="noopener"
            class="group relative block aspect-square h-full w-full overflow-hidden rounded-2xl border border-white/10 bg-gradient-to-br from-coal-700 to-coal-800 sm:rounded-3xl"
            aria-label={`Instagram post: ${truncate(p.caption, 60) || 'Grand BBQ post'}`}
          >
            <img src={p.image_url} alt={truncate(p.caption, 90) || 'Grand BBQ dish on Instagram'} loading="lazy" referrerpolicy="no-referrer" class="h-full w-full object-cover transition duration-[900ms] ease-out group-hover:scale-110" />
            <div class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-coal-950/95 via-coal-950/40 to-transparent p-4 opacity-0 transition-opacity duration-500 group-hover:opacity-100 group-focus-visible:opacity-100 sm:p-5">
              <p class="line-clamp-3 font-arabic text-sm leading-relaxed text-ash-100" lang="ar" dir="rtl">{truncate(p.caption)}</p>
              <div class="mt-3 flex items-center gap-4 text-xs font-semibold text-ash-200">
                <span class="inline-flex items-center gap-1.5">
                  <svg viewBox="0 0 24 24" class="h-4 w-4 text-ember-400" fill="currentColor" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.5-9.3C1 8 3.4 4.5 7 4.5c2 0 3.4 1.1 5 3 1.6-1.9 3-3 5-3 3.6 0 6 3.5 4.5 7.2C19.5 16.4 12 21 12 21Z"/></svg>
                  {p.likes > 0 ? fmt(p.likes) : 'Like'}
                </span>
                <span class="inline-flex items-center gap-1.5">
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12a8.5 8.5 0 0 1-12.6 7.4L3 21l1.6-5.2A8.5 8.5 0 1 1 21 12Z"/></svg>
                  Comment
                </span>
                <span class="ml-auto">View ↗</span>
              </div>
            </div>
            <span class="absolute right-3 top-3 grid h-8 w-8 place-items-center rounded-full bg-coal-950/50 backdrop-blur" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/></svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>