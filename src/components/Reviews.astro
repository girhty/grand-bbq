---
interface Props { rating: number; total: number; followers: number }
const { rating, total, followers } = Astro.props;

const full = Math.floor(rating);
const partial = rating - full;

const quotes = [
  {
    ar: 'من المطاعم اللي تدخلها على تجربة وتطلع وأنت تكول: لازم أرجع مرة ثانية! 😍👌',
    en: 'One of those restaurants you walk into to try — and walk out saying: I have to come back!',
    who: 'Basra food creator',
  },
  {
    ar: 'كراند باربكيو اطيب لحم مدخن جربته 🥩🔥',
    en: 'Grand BBQ — the best smoked meat I’ve ever tried.',
    who: 'Guest post · Time Square Basra',
  },
  {
    ar: 'اليوم اني يم @grand.bbq حرفياً اطيب مطعم بل بصرة',
    en: 'Today I’m at Grand BBQ — literally the tastiest restaurant in Basra.',
    who: 'Local reviewer',
  },
  {
    ar: 'كانت تجربه تستحق صراحه… الاكل يخبل ولاغلطه والمكان يجنن',
    en: 'Honestly an experience worth it… the food is insane, not a single mistake, and the place is stunning.',
    who: 'Food blogger',
  },
];
---

<section id="reviews" class="relative py-24 sm:py-32" aria-labelledby="reviews-title">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="reveal text-xs font-semibold uppercase tracking-eyebrow text-flame-400">— Social Proof</p>
        <h2 id="reviews-title" class="reveal mt-4 font-display text-[clamp(2.6rem,5vw,4.5rem)] uppercase leading-[0.9]" style="--d:100ms">
          Basra is <span class="text-fire">talking.</span>
        </h2>
        <p class="reveal mt-5 text-ash-300" style="--d:150ms">
          Word of mouth built Grand BBQ. Here’s what guests and local food creators say — in their own words.
        </p>

        <div class="glow-border reveal-scale mt-8 rounded-3xl bg-coal-800/70 p-6" style="--d:200ms">
          <div class="flex items-center gap-3">
            <svg viewBox="0 0 48 48" class="h-8 w-8" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3A12 12 0 1 1 24 12c3 0 5.8 1.1 7.9 3l5.7-5.7A20 20 0 1 0 44 24c0-1.2-.1-2.3-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8A12 12 0 0 1 24 12c3 0 5.8 1.1 7.9 3l5.7-5.7A20 20 0 0 0 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2A12 12 0 0 1 12.7 28l-6.5 5A20 20 0 0 0 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3a12 12 0 0 1-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.2-.1-2.3-.4-3.5z"/></svg>
            <p class="text-sm font-semibold text-ash-200">Google Reviews</p>
          </div>
          <div class="mt-4 flex items-end gap-3">
            <span class="font-display text-6xl leading-none">{rating}</span>
            <div class="pb-1">
              <div class="flex gap-0.5 text-xl" role="img" aria-label={`Rated ${rating} out of 5`}>
                {[0, 1, 2, 3, 4].map((i) => (
                  <span class="relative inline-block text-white/15" aria-hidden="true">
                    ★
                    <span class="absolute inset-0 overflow-hidden text-flame-400" style={`width:${i < full ? 100 : i === full ? Math.round(partial * 100) : 0}%`}>★</span>
                  </span>
                ))}
              </div>
              <p class="text-xs text-ash-400">Based on {total} Google reviews</p>
            </div>
          </div>
          <div class="mt-5 flex items-center justify-between rounded-2xl bg-white/[0.04] px-4 py-3">
            <span class="text-sm text-ash-300">Instagram community</span>
            <span class="font-display text-2xl">{followers.toLocaleString('en-US')}</span>
          </div>
          <a
            href="https://www.google.com/maps/search/?api=1&query=Grand+BBQ+GR7G%2B2WQ+Basrah"
            target="_blank"
            rel="noopener"
            class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-full border border-white/15 py-3 text-sm font-semibold transition hover:border-flame-400/60 hover:bg-white/5"
          >
            Leave us a review <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:col-span-8">
        {quotes.map((q, i) => (
          <figure class="glow-border reveal group flex flex-col justify-between rounded-3xl bg-coal-800/60 p-7 transition-transform duration-500 hover:-translate-y-1" style={`--d:${i * 100}ms`}>
            <div>
              <svg viewBox="0 0 32 32" class="h-8 w-8 text-ember-500/70" fill="currentColor" aria-hidden="true"><path d="M10 8C5.6 8 3 11.3 3 15.6V24h8.4v-8.4H7.2c0-3 1.4-4.8 4-5.2L10 8Zm15 0c-4.4 0-7 3.3-7 7.6V24h8.4v-8.4h-4.2c0-3 1.4-4.8 4-5.2L25 8Z"/></svg>
              <blockquote class="mt-4">
                <p class="font-arabic text-xl leading-relaxed text-ash-100" lang="ar" dir="rtl">{q.ar}</p>
                <p class="mt-3 text-sm italic leading-relaxed text-ash-400">“{q.en}”</p>
              </blockquote>
            </div>
            <figcaption class="mt-6 flex items-center gap-3 border-t border-white/5 pt-5">
              <span class="grid h-9 w-9 place-items-center rounded-full bg-gradient-to-br from-flame-400 to-ember-600 text-sm font-bold text-coal-950" aria-hidden="true">{q.who.charAt(0)}</span>
              <span>
                <span class="block text-sm font-semibold">{q.who}</span>
                <span class="block text-xs text-ash-400">via Instagram</span>
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>