---
const faqs = [
  {
    q: 'Where is Grand BBQ located?',
    a: 'We have two branches in Basra: our flagship in Al-Sa’i (Al-Tuwaisa area, plus code GR7G+2WQ) and a second branch in Madinat Al-Amal. Tap “Directions” in the Visit section to navigate.',
  },
  {
    q: 'Can I reserve a table?',
    a: 'Yes — call your nearest branch directly. Al-Sa’i: 0772 511 1190 · Madinat Al-Amal: 0771 351 3571. For weekends and group dinners we recommend calling ahead.',
  },
  {
    q: 'Do you offer takeaway or delivery?',
    a: 'Call or WhatsApp your branch to place a takeaway order and ask about delivery availability in your area.',
  },
  {
    q: 'What should I order on my first visit?',
    a: 'Start with the slow-smoked meats — guests call it the best smoked meat they’ve tried — then add a Grand smash burger. If you’re in the mood for something different, try one of our Italian plates.',
  },
  {
    q: 'Is Grand BBQ family-friendly?',
    a: 'Absolutely. The space was designed with warm lighting and comfortable seating for friends and families, with share-style platters made for the whole table.',
  },
  {
    q: 'What are your opening hours?',
    a: 'We’re open daily. Hours may shift on holidays and during Ramadan, so please call your branch to confirm today’s timings.',
  },
];
---

<section id="faq" class="relative py-24 sm:py-32" aria-labelledby="faq-title">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 sm:px-8 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <p class="reveal text-xs font-semibold uppercase tracking-eyebrow text-flame-400">— FAQ</p>
      <h2 id="faq-title" class="reveal mt-4 font-display text-[clamp(2.6rem,5vw,4.5rem)] uppercase leading-[0.9]" style="--d:100ms">
        Good <span class="text-fire">questions.</span>
      </h2>
      <p class="reveal mt-5 text-ash-300" style="--d:150ms">Can’t find what you need? Give us a ring — a real person will answer.</p>
      <a href="tel:+9647725111190" class="reveal mt-6 inline-flex items-center gap-2 font-semibold text-flame-300 hover:text-flame-400" style="--d:200ms">0772 511 1190 →</a>
    </div>

    <div class="space-y-3 lg:col-span-8">
      {faqs.map((f, i) => (
        <details class="faq-item reveal group rounded-2xl border border-white/10 bg-coal-800/60 transition-colors open:border-ember-500/40 open:bg-coal-800 hover:border-white/20" style={`--d:${i * 70}ms`} name="faq">
          <summary class="flex cursor-pointer items-center justify-between gap-6 rounded-2xl px-6 py-5 text-left text-lg font-semibold">
            {f.q}
            <span class="faq-icon grid h-9 w-9 shrink-0 place-items-center rounded-full border border-white/15 text-xl text-flame-300 group-open:border-ember-500 group-open:bg-ember-500 group-open:text-coal-950" aria-hidden="true">+</span>
          </summary>
          <div class="faq-body">
            <div class="overflow-hidden">
              <p class="px-6 pb-6 leading-relaxed text-ash-300">{f.a}</p>
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>