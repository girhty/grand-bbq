---
interface Branch { name: string; nameAr: string; area: string; plus: string | null; phone: string; tel: string; flagship: boolean }
interface Props { branches: Branch[]; address: string; openNow: boolean }
const { branches, address, openNow } = Astro.props;
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent('Grand BBQ ' + address)}&output=embed`;
---

<section id="visit" class="relative py-24 sm:py-32" aria-labelledby="visit-title">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <p class="reveal text-xs font-semibold uppercase tracking-eyebrow text-flame-400">— Visit Us</p>
    <h2 id="visit-title" class="reveal mt-4 font-display text-[clamp(2.6rem,6vw,5rem)] uppercase leading-[0.9]" style="--d:100ms">
      Two fires. <span class="text-fire">One Basra.</span>
    </h2>

    <div class="mt-14 grid gap-5 lg:grid-cols-12">
      <div class="grid gap-5 lg:col-span-5">
        {branches.map((b, i) => (
          <article class="glow-border reveal rounded-3xl bg-coal-800/70 p-7" style={`--d:${i * 120}ms`}>
            <div class="flex items-start justify-between gap-4">
              <div>
                {b.flagship && <span class="mb-2 inline-block rounded-full bg-ember-500/15 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-ember-300">Flagship</span>}
                <h3 class="font-display text-3xl tracking-wide">{b.name}</h3>
                <p class="font-arabic text-ash-300" lang="ar" dir="rtl">{b.nameAr}</p>
              </div>
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-white/5 text-2xl" aria-hidden="true">📍</span>
            </div>
            <dl class="mt-5 space-y-2 text-sm">
              <div class="flex gap-3"><dt class="w-20 shrink-0 text-ash-400">Area</dt><dd class="text-ash-200">{b.area}</dd></div>
              {b.plus && <div class="flex gap-3"><dt class="w-20 shrink-0 text-ash-400">Plus code</dt><dd class="text-ash-200">{b.plus}</dd></div>}
              <div class="flex gap-3"><dt class="w-20 shrink-0 text-ash-400">Phone</dt><dd><a href={`tel:${b.tel}`} class="font-semibold text-flame-300 hover:text-flame-400">{b.phone}</a></dd></div>
            </dl>
            <div class="mt-6 flex flex-wrap gap-3">
              <a href={`tel:${b.tel}`} class="inline-flex items-center gap-2 rounded-full bg-ember-500 px-5 py-2.5 text-sm font-bold text-coal-950 transition hover:bg-flame-400">Call branch</a>
              <a href={`https://wa.me/${b.tel.replace('+', '')}`} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full border border-white/15 px-5 py-2.5 text-sm font-semibold transition hover:border-emerald-400/60 hover:bg-emerald-400/10">WhatsApp</a>
              <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent('Grand BBQ ' + (b.plus ? b.plus + ' Basrah' : b.area))}`} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full border border-white/15 px-5 py-2.5 text-sm font-semibold transition hover:border-flame-400/60 hover:bg-white/5">Directions ↗</a>
            </div>
          </article>
        ))}

        <article class="reveal rounded-3xl border border-white/10 bg-gradient-to-br from-ember-600/20 to-transparent p-7" style="--d:240ms">
          <div class="flex items-center justify-between">
            <h3 class="font-display text-2xl tracking-wide">Opening Hours</h3>
            {openNow && (
              <span class="inline-flex items-center gap-2 rounded-full bg-emerald-400/10 px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-emerald-300">
                <span class="h-2 w-2 rounded-full bg-emerald-400"></span> Open now
              </span>
            )}
          </div>
          <p class="mt-3 text-ash-300">Serving daily for lunch, dinner and late nights. Hours can vary on holidays &amp; during Ramadan — call your branch to confirm before you visit.</p>
        </article>
      </div>

      <div class="reveal-scale relative min-h-[420px] overflow-hidden rounded-3xl border border-white/10 bg-coal-800 lg:col-span-7" style="--d:150ms">
        <iframe
          title="Map showing Grand BBQ Al-Sa'i branch in Basra"
          src={mapSrc}
          class="absolute inset-0 h-full w-full grayscale-[70%] invert-[90%] hue-rotate-180 contrast-[.9]"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        <div class="pointer-events-none absolute inset-0 ring-1 ring-inset ring-white/10 rounded-3xl"></div>
        <div class="glass absolute bottom-4 left-4 right-4 rounded-2xl p-4 sm:right-auto sm:w-80">
          <p class="text-[11px] font-semibold uppercase tracking-eyebrow text-flame-300">Flagship address</p>
          <p class="mt-1 font-semibold">{address}</p>
          <p class="text-sm text-ash-300">Al-Tuwaisa · Al-Sa’i, Basra</p>
        </div>
      </div>
    </div>
  </div>
</section>