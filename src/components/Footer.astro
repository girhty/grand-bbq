---
interface Branch { name: string; nameAr: string; area: string; phone: string; tel: string }
interface Props { branches: Branch[]; igUrl: string }
const { branches, igUrl } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="relative border-t border-white/5 bg-coal-950 pt-20 pb-10" aria-labelledby="footer-title">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <h2 id="footer-title" class="font-display text-5xl tracking-wide">GRAND BBQ</h2>
        <p class="font-arabic text-xl text-ash-300" lang="ar" dir="rtl">كراند باربكيو</p>
        <p class="mt-4 max-w-sm text-ash-400">Best BBQ &amp; Burger in town. Smoked low &amp; slow in Basra, by Chef Murad.</p>
        <a href={igUrl} target="_blank" rel="noopener" class="mt-6 inline-flex items-center gap-2 rounded-full border border-white/10 px-5 py-2.5 text-sm font-semibold transition hover:border-ember-500/60 hover:bg-white/5" aria-label="Grand BBQ on Instagram">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
          @grand.bbq
        </a>
      </div>

      {branches.map((b) => (
        <div class="md:col-span-3">
          <h3 class="text-xs font-semibold uppercase tracking-eyebrow text-flame-400">{b.name}</h3>
          <p class="mt-3 font-arabic text-ash-200" lang="ar" dir="rtl">{b.nameAr}</p>
          <p class="text-sm text-ash-400">{b.area}</p>
          <a href={`tel:${b.tel}`} class="mt-2 inline-block font-semibold text-ash-100 hover:text-flame-300">{b.phone}</a>
        </div>
      ))}
    </div>

    <nav aria-label="Footer" class="mt-16 flex flex-col items-start justify-between gap-6 border-t border-white/5 pt-8 text-sm text-ash-500 sm:flex-row sm:items-center">
      <p>© {year} Grand BBQ, Basra. All rights reserved.</p>
      <ul class="flex flex-wrap gap-6">
        <li><a href="#menu" class="hover:text-ash-200">Signatures</a></li>
        <li><a href="#reviews" class="hover:text-ash-200">Reviews</a></li>
        <li><a href="#visit" class="hover:text-ash-200">Visit</a></li>
        <li><a href="#top" class="hover:text-ash-200">Back to top ↑</a></li>
      </ul>
    </nav>
  </div>

  <p aria-hidden="true" class="pointer-events-none mt-10 select-none overflow-hidden text-center font-display text-[22vw] leading-[0.8] text-white/[0.03]">GRAND</p>
</footer>