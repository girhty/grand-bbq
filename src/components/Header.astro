---
interface Props { phone: string }
const { phone } = Astro.props;
const links = [
  { href: '#menu', label: 'Signatures' },
  { href: '#story', label: 'Chef Murad' },
  { href: '#reviews', label: 'Reviews' },
  { href: '#instagram', label: 'Instagram' },
  { href: '#visit', label: 'Visit' },
  { href: '#faq', label: 'FAQ' },
];
---

<header
  data-header
  class="group fixed inset-x-0 top-0 z-50 transition-all duration-500"
  transition:persist
>
  <div class="mx-auto mt-3 flex max-w-7xl items-center justify-between gap-4 rounded-full px-4 py-2.5 transition-all duration-500 sm:px-6 group-data-[scrolled]:glass group-data-[scrolled]:mx-3 group-data-[scrolled]:shadow-[0_10px_40px_-10px_rgba(0,0,0,.6)] lg:group-data-[scrolled]:mx-auto">
    <a href="#top" class="flex items-center gap-2.5" aria-label="Grand BBQ — home">
      <span class="relative grid h-10 w-10 place-items-center rounded-full bg-gradient-to-br from-flame-400 to-ember-600 shadow-[0_0_24px_-4px_rgba(255,90,31,.8)]">
        <svg viewBox="0 0 24 24" class="h-5 w-5 text-coal-950" fill="currentColor" aria-hidden="true"><path d="M12 2c1 3.5 4.5 5 4.5 9.5A4.5 4.5 0 0 1 12 16a4.5 4.5 0 0 1-4.5-4.5c0-1.6.6-2.8 1.5-3.8.2 1.5 1 2.5 2 2.8C10.5 7.5 11 4.5 12 2Zm-7 16h14v2H5z"/></svg>
      </span>
      <span class="leading-none">
        <span class="block font-display text-xl tracking-wide">GRAND BBQ</span>
        <span class="block font-arabic text-[11px] text-ash-300" lang="ar" dir="rtl">كراند باربكيو</span>
      </span>
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {links.map((l) => (
          <li>
            <a href={l.href} class="relative rounded-full px-4 py-2 text-sm font-medium text-ash-200 transition hover:bg-white/5 hover:text-white">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={`tel:${phone}`}
        class="magnetic hidden items-center gap-2 rounded-full bg-ember-500 px-5 py-2.5 text-sm font-bold text-coal-950 shadow-[0_0_30px_-6px_rgba(255,90,31,.9)] hover:bg-flame-400 sm:inline-flex"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z"/></svg>
        Call to Order
      </a>
      <button
        data-menu-toggle
        type="button"
        class="grid h-11 w-11 place-items-center rounded-full border border-white/10 bg-white/5 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle menu"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    data-menu
    data-open="false"
    class="pointer-events-none fixed inset-x-3 top-20 origin-top scale-95 rounded-3xl p-6 opacity-0 transition-all duration-300 glass data-[open=true]:pointer-events-auto data-[open=true]:scale-100 data-[open=true]:opacity-100 lg:hidden"
  >
    <nav aria-label="Mobile">
      <ul class="grid gap-1">
        {links.map((l) => (
          <li><a href={l.href} class="block rounded-2xl px-4 py-3 font-display text-2xl tracking-wide hover:bg-white/5">{l.label}</a></li>
        ))}
      </ul>
      <a href={`tel:${phone}`} class="mt-4 flex items-center justify-center rounded-full bg-ember-500 py-3.5 font-bold text-coal-950">Call 0772 511 1190</a>
    </nav>
  </div>
</header>