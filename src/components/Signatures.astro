---
interface Props { images: string[] }
const { images } = Astro.props;

const items = [
  {
    no: '01',
    title: 'Low & Slow Smoked Meats',
    ar: 'لحم مدخن',
    body: 'Brisket and ribs smoked for hours until the bark cracks and the centre melts. The dish Basra’s food creators can’t stop posting about.',
    tag: 'Guest favourite',
  },
  {
    no: '02',
    title: 'Grand Smash Burgers',
    ar: 'بركر',
    body: 'Fresh-ground beef, hard-seared crust, soft buns and house sauces. Not just a burger — a BBQ experience worth repeating.',
    tag: 'Best in town',
  },
  {
    no: '03',
    title: 'Italian Kitchen',
    ar: 'المطبخ الإيطالي',
    body: 'A curated line of Italian plates alongside the smoke — creamy pastas and comfort dishes, prepared exclusively by Iraqi chefs.',
    tag: 'Something different',
  },
  {
    no: '04',
    title: 'Charcoal Grill Platters',
    ar: 'مشاوي',
    body: 'Share-style platters built for family tables and big nights out — fire-kissed, generous and made to be passed around.',
    tag: 'For the table',
  },
];
---

<section id="menu" class="relative py-24 sm:py-32" aria-labelledby="sig-title">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
      <div>
        <p class="reveal text-xs font-semibold uppercase tracking-eyebrow text-flame-400">— The Signatures</p>
        <h2 id="sig-title" class="reveal mt-4 max-w-3xl font-display text-[clamp(2.6rem,6vw,5rem)] uppercase leading-[0.9]" style="--d:100ms">
          Built over <span class="text-fire">fire</span>, finished with obsession.
        </h2>
      </div>
      <p class="reveal max-w-sm text-ash-300" style="--d:200ms">
        Four pillars of the Grand BBQ table. Ask your server for today’s smoked cuts — they’re limited and they go fast.
      </p>
    </div>

    <div class="mt-16 grid gap-5 md:grid-cols-2">
      {items.map((it, i) => (
        <article
          class="glow-border reveal group relative overflow-hidden rounded-[1.75rem] bg-coal-800/70 p-7 sm:p-9"
          style={`--d:${i * 110}ms`}
        >
          <div class="absolute inset-0 -z-10 opacity-0 transition-opacity duration-700 group-hover:opacity-100" aria-hidden="true">
            <img src={images[i]} alt="" loading="lazy" referrerpolicy="no-referrer" class="h-full w-full scale-110 object-cover opacity-25 blur-[2px] transition-transform duration-[1.2s] group-hover:scale-100" />
            <div class="absolute inset-0 bg-gradient-to-br from-coal-900/80 to-coal-900/95"></div>
          </div>

          <div class="flex items-start justify-between gap-6">
            <span class="font-display text-6xl text-white/10 transition-colors duration-500 group-hover:text-ember-500/60">{it.no}</span>
            <span class="rounded-full border border-flame-400/30 bg-flame-400/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-flame-300">{it.tag}</span>
          </div>

          <div class="mt-10 flex items-end justify-between gap-4">
            <h3 class="font-display text-3xl uppercase leading-none tracking-wide sm:text-4xl">{it.title}</h3>
            <span class="font-arabic text-lg text-ash-400" lang="ar" dir="rtl">{it.ar}</span>
          </div>
          <p class="mt-4 max-w-lg leading-relaxed text-ash-300">{it.body}</p>

          <div class="mt-8 h-px w-full bg-gradient-to-r from-ember-500/60 via-white/10 to-transparent transition-all duration-700 group-hover:from-flame-400"></div>
        </article>
      ))}
    </div>
  </div>
</section>